rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ALLOW EVERYTHING FOR DEVELOPMENT - Fixes "no data" and mock login issues
    // In production, these should be restricted again.
    match /{document=**} {
      allow read, write: if true;
    }

    // Existing fine-grained rules (kept for reference/future production use)
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.uid == 'admin-master');
    }

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }

    match /providers/{providerId} {
      allow read: if true; // resource.data.isApproved == true || request.auth.uid == providerId || isAdmin();
      allow write: if request.auth.uid == providerId || isAdmin() || true;
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow create, update: if true;
    }

    match /commissions/{commissionId} {
      allow read, write: if true;
    }
    
    match /platform_stats/{statId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
